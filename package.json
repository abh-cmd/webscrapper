{
  "name": "wine-outlet-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "Phase 1 Wine Outlet product-data crawler foundation.",
  "main": "src/index.js",
  "scripts": {
    "crawl": "node src/index.js",
    "batch": "node src/batch/run-batch-cli.js",
    "schedule": "node src/scheduler/run-scheduler-cli.js",
    "image:cleanup": "node src/images/run-cleanup-cli.js",
    "compliance:seed": "node src/compliance/seed-production-sources.js",
    "config:check": "node src/config/check-config-cli.js",
    "serve": "node src/api/server.js",
    "start": "node src/api/server.js",
    "build": "npm --prefix frontend run build",
    "fixtures:serve": "node scripts/fixture-static-server.js",
    "test": "node --test --test-concurrency=1",
    "db:migrate": "node src/db/migrate.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "crawlee": "^3.12.2",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "playwright": "^1.49.1"
  }
}
