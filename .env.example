CRAWL_TIMEOUT_MS=30000
PLAYWRIGHT_HEADLESS=true

# Third pass: the frontend + backend API server (npm run serve).
# PORT=3100

# Phase 9: PostgreSQL connection string for product persistence, and for
# every table added since (queue, snapshots, field history, images,
# staging, master data, compliance, request budget, scheduled runs). Run
# `npm run db:migrate` after setting this. Database-dependent tests are
# skipped automatically when this is unset. Run `npm run config:check`
# after editing this file to validate everything below at once.
DATABASE_URL=postgres://user:password@localhost:5432/wine_outlet

# Block 1 / final phase: proxy pool. No proxy provider is configured for
# this project — leave PROXY_LIST unset and the pool is honestly empty
# (requests go out direct, not silently through some default). See
# src/net/proxy-config.js and src/net/proxy-provider.js.
# Format: a JSON array of { id, url, tier } objects — tier is opaque
# metadata ("residential" / "datacenter" / anything else you use).
# PROXY_LIST=[{"id":"p1","url":"http://user:pass@host:port","tier":"residential"}]
# PROXY_COOLDOWN_MS=60000
# PROXY_EJECT_AFTER_CONSECUTIVE_FAILURES=3
# PROXY_EJECT_AFTER_BLOCK_COUNT=2
# PROXY_PROVIDER selects where the list above comes from: "env-list"
# (default, reads PROXY_LIST) or "none" (always direct mode, even if
# PROXY_LIST is set — useful to force-disable proxying without deleting
# the list). A real third-party provider integration would be a new value
# here, added in src/net/proxy-provider.js — not a redesign.
# PROXY_PROVIDER=env-list

# Final phase: per-domain rate limiting. The four approved production
# hostnames (wine.com, totalwine.com, wine-searcher.com, vivino.com) get a
# conservative built-in default (1 req/sec, concurrency 1) with NO
# configuration needed — see src/net/rate-limit-config.js. Every other
# domain (including any local/test server) is unthrottled unless you add
# it here. Format: a JSON object mapping hostname -> { ratePerSecond,
# burst, concurrency }; entries here override the built-in defaults too.
# RATE_LIMIT_CONFIG={"www.wine.com":{"ratePerSecond":2,"burst":2,"concurrency":1}}

# Final phase: operational controls. Both default to "everything allowed."
# CRAWLER_KILL_SWITCH=true stops every crawl immediately (checked fresh on
# every call — no restart needed if you set it via your process manager's
# live environment, though a plain .env change still requires a restart).
# DISABLED_SOURCES is a comma-separated list of source names to refuse.
# CRAWLER_KILL_SWITCH=false
# DISABLED_SOURCES=wine-com,total-wine

# Final phase: per-source daily request budget. "Proxy budget" is an
# explicitly OPEN business decision in the requirements document — no
# number is invented here. With both unset, usage is still counted (in the
# request_budget table) but never enforced. Set a global default, a
# per-source override (MAX_REQUESTS_PER_SOURCE_PER_DAY_<SOURCE_NAME>, e.g.
# _WINE_COM), or both — per-source wins. See src/net/request-budget.js.
# MAX_REQUESTS_PER_SOURCE_PER_DAY=1000
# MAX_REQUESTS_PER_SOURCE_PER_DAY_WINE_COM=200

# Block 3 / final phase: image storage and retention. Root directory
# defaults to ./output/images if unset. IMAGE_RETENTION_DAYS is unset by
# default (retention policy is another explicitly OPEN business decision
# in the requirements document) — `npm run image:cleanup` is then a no-op.
# Set it to enable cleanup of unreferenced images older than N days (never
# an image still attached to a product, regardless of age).
# IMAGE_STORAGE_ROOT=./output/images
# IMAGE_RETENTION_DAYS=90

# Final phase: AI provider selection. One of:
#   deterministic-test (default, safe — no real AI, rule-based, always
#     tagged provider: "deterministic-test" so it can never be mistaken
#     for a real AI result)
#   http  (a real OpenAI-chat-completions-compatible HTTP client — requires
#     AI_API_BASE_URL/AI_API_KEY/AI_MODEL below; never exercised against a
#     real provider in this environment, since no API key exists here)
#   none  (a no-op provider; paraphrasing/analysis are both skipped)
AI_PROVIDER=deterministic-test
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2

# Final phase: operational alert thresholds (src/observability/alerts.js).
# All optional — safe defaults apply if unset (see DEFAULT_THRESHOLDS).
# ALERT_BLOCK_RATE_THRESHOLD=0.5
# ALERT_ZERO_ITEMS_ENABLED=true
# ALERT_IMAGE_REJECTION_RATE_THRESHOLD=0.3
# ALERT_IMAGE_PLACEHOLDER_RATE_THRESHOLD=0.3

# Final phase: the optional in-process scheduler (src/scheduler/). Refresh
# cadence is an explicitly OPEN business decision — both must be set
# together for `npm run schedule` to do anything; with either unset, the
# scheduler process exits immediately with a clear message instead of
# guessing a cadence. Any external scheduler (cron, Task Scheduler, a CI
# scheduled job) invoking `npm run batch` directly remains a fully valid
# alternative to this — this is not the only way to get a cadence.
# SCHEDULE_INTERVAL_MINUTES=1440
# SCHEDULE_BATCH_FILE=input/batch/products.json
